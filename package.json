{
  "name": "rug-lang",
  "version": "0.0.2",
  "description": "A minimal templating language with clean indentation-based syntax",
  "license": "MIT",
  "repository": "github:spencermountain/rug-lang",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./builds/rug-lang.mjs"
      },
      "require": {
        "types": "./src/index.d.cts",
        "default": "./builds/rug-lang.cjs"
      }
    }
  },
  "main": "./builds/rug-lang.cjs",
  "module": "./builds/rug-lang.mjs",
  "types": "./src/index.d.cts",
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c",
    "test": "node tests/index.js",
    "watch": "node --watch scratch.js",
    "lint": "eslint ."
  },
  "files": [
    "builds",
    "language-configuration.json",
    "src",
    "syntaxes"
  ],
  "keywords": [
    "markup"
  ],
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "eslint": "10.11.0",
    "rollup": "^4.63.4",
    "tap-dancer": "^0.4.0",
    "tape": "^5.10.2"
  },
  "unpkg": "builds/rug-lang.min.js",
  "contributes": {
    "languages": [
      {
        "id": "rug",
        "aliases": [
          "Rug",
          "rug"
        ],
        "extensions": [
          ".rug"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rug",
        "scopeName": "source.rug",
        "path": "./syntaxes/rug.tmLanguage.json"
      }
    ]
  }
}
