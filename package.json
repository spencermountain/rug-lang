{
  "name": "rug-lang",
  "version": "0.0.2",
  "type": "module",
  "description": "A minimal templating language with clean indentation-based syntax",
  "main": "builds/rug-lang.cjs",
  "module": "builds/rug-lang.mjs",
  "unpkg": "builds/rug-lang.min.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./builds/rug-lang.mjs",
      "require": "./builds/rug-lang.cjs"
    }
  },
  "files": [
    "src",
    "builds",
    "README.md",
    "syntaxes",
    "language-configuration.json"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "node --test",
    "watch": "node --watch scratch.js"
  },
  "keywords": [
    "markup"
  ],
  "author": "Spencer Kelly",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spencermountain/rug-lang.git"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "rollup": "^4.12.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "rug",
        "aliases": [
          "Rug",
          "rug"
        ],
        "extensions": [
          ".rug"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rug",
        "scopeName": "source.rug",
        "path": "./syntaxes/rug.tmLanguage.json"
      }
    ]
  },
  "license": "MIT"
}