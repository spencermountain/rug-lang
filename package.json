{
  "name": "rug-lang",
  "version": "0.1.0",
  "type": "module",
  "description": "A minimal templating language with clean indentation-based syntax",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "builds",
    "README.md",
    "syntaxes",
    "language-configuration.json"
  ],
  "scripts": {
    "test": "node --test",
    "watch": "node --watch scratch.js"
  },
  "keywords": [
    "markup"
  ],
  "author": "Spencer Kelly",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spencermountain/rug-lang.git"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "rollup": "^4.12.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "rug",
        "aliases": [
          "Rug",
          "rug"
        ],
        "extensions": [
          ".rug"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rug",
        "scopeName": "source.rug",
        "path": "./syntaxes/rug.tmLanguage.json"
      }
    ]
  }
}